  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "MedicationRequest" ] ;
       fhir:ElementDefinition.path [ fhir:value "MedicationRequest" ] ;
       fhir:ElementDefinition.short [ fhir:value "Prescrição de medicamento para um paciente" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Uma ordem ou solicitação para o fornecimento do medicamento e as instruções para sua administração a um paciente. O recurso é denominado \"MedicationRequest\" em vez de \"MedicationPrescription\" ou \"MedicationOrder\" para generalizar o uso em ambientes hospitalares e ambulatoriais, incluindo planos de cuidados, etc., e para harmonizar com os fluxos de trabalho." ] ;
       fhir:ElementDefinition.constraint [
         fhir:index -1 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "pem-1" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "O profissional deve ter uma identificação de Médico, Odontólogo ou Enfermeiro (Practitioner.identifier)." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "MedicationRequest.requester.resolve().ofType(PractitionerRole).practitioner.resolve().ofType(Practitioner).identifier.type.coding.exists(code = 'MD' or code = 'RN' or code = 'RI' or code = 'MRT')" ]
       ], [
         fhir:index -1 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "pem-2" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "O profissional deve ser identificado pelo CPF ou CNS (Practitioner.identifier)." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "MedicationRequest.requester.resolve().ofType(PractitionerRole).practitioner.resolve().ofType(Practitioner).identifier.type.coding.exists(code = 'PHO' or code = 'TAX')" ]
       ], [
         fhir:index -1 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "pem-3" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Ao informar o número do RQE o número do CRM também é obrigatório na identificação do médico (Practitioner.identifier)." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "MedicationRequest.requester.resolve().ofType(PractitionerRole).practitioner.resolve().ofType(Practitioner).identifier.type.coding.where(code = 'DN').exists() implies MedicationRequest.requester.resolve().ofType(PractitionerRole).practitioner.resolve().ofType(Practitioner).identifier.type.coding.where(code = 'MD').exists()" ]
       ], [
         fhir:index -1 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "pem-7" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "A identificação do responsável pelo indivíduo (MedicationRequest.supportingInformation.identifier.value) deve ser diferente da identificação do indivíduo (MedicationRequest.subject.identifier.value)." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "MedicationRequest.supportingInformation.exists() implies MedicationRequest.supportingInformation.identifier.value != MedicationRequest.subject.identifier.value" ]
       ]
