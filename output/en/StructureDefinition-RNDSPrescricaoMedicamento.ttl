       fhir:ElementDefinition.path [ fhir:value "MedicationRequest.status" ] ;
       fhir:ElementDefinition.short [ fhir:value "Status atual da prescrição" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Status atual da prescrição de medicamento: ativa, em espera, cancelada, concluída, registrada por engano, interrompida, rascunho, desconhecido" ]
     ], [
