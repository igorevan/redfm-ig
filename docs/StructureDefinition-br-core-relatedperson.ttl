       fhir:short [ fhir:v "A person that is related to a patient, but who is not a direct target of care" ] ;
       fhir:definition [ fhir:v "Information about a person that is involved in the care for a patient, but who is not the target of healthcare, nor has a formal responsibility in the care process." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
