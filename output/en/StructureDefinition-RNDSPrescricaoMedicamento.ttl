       fhir:ElementDefinition.mapping [
         fhir:index -1 ;
         fhir:ElementDefinition.mapping.identity [ fhir:value "v2" ] ;
         fhir:ElementDefinition.mapping.map [ fhir:value "RXO-2, RXE-3" ]
       ], [
         fhir:index -1 ;
