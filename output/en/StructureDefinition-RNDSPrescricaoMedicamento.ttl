       fhir:ElementDefinition.short [ fhir:value "Valor numérico (com precisão implícita)." ] ;
       fhir:ElementDefinition.definition [ fhir:value "O valor da quantidade medida. O valor inclui uma precisão implícita na apresentação do valor." ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "MedicationRequest.dispenseRequest.quantity.unit" ] ;
       fhir:ElementDefinition.path [ fhir:value "MedicationRequest.dispenseRequest.quantity.unit" ] ;
       fhir:ElementDefinition.short [ fhir:value "Representação da unidade." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Uma forma da unidade que pode ser lida por humanos." ]
     ], [
       fhir:index -1 ;
