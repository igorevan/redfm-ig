         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Ao informar o número do RQE o número do CRM também é obrigatório no slice prescriberIdentifier." ] ;
