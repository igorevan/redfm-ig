       fhir:ElementDefinition.path [ fhir:value "MedicationDispense.substitution.wasSubstituted" ] ;
       fhir:ElementDefinition.short [ fhir:value "Se foi ou não realizada uma substituição na dispensação do medicamento" ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "MedicationDispense.substitution.type" ] ;
       fhir:ElementDefinition.path [ fhir:value "MedicationDispense.substitution.type" ] ;
       fhir:ElementDefinition.short [ fhir:value "Código que indica se um medicamento diferente do prescrito foi substituido" ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "MedicationDispense.substitution.reason" ] ;
       fhir:ElementDefinition.path [ fhir:value "MedicationDispense.substitution.reason" ] ;
       fhir:ElementDefinition.short [ fhir:value "Porque a substituição foi feita" ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "MedicationDispense.substitution.responsibleParty" ] ;
       fhir:ElementDefinition.path [ fhir:value "MedicationDispense.substitution.responsibleParty" ] ;
       fhir:ElementDefinition.short [ fhir:value "Referência ao profissional responsável pela substituição do medicamento" ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "Reference" ] ;
         fhir:ElementDefinition.type.targetProfile [
           fhir:value "http://www.saude.gov.br/fhir/r4/StructureDefinition/RNDSLotacaoProfissional" ;
           fhir:index -1 ;
           fhir:link <http://www.saude.gov.br/fhir/r4/StructureDefinition/RNDSLotacaoProfissional>
         ]
       ]
     ], [
