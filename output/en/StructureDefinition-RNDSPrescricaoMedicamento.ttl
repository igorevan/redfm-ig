       fhir:ElementDefinition.short [ fhir:value "Data/Hora do final da validade da autorização(intervalo fechado)" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Data/Hora do final da validade da autorização(intervalo fechado), se não for contínuo" ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "MedicationRequest.dispenseRequest.numberOfRepeatsAllowed" ] ;
       fhir:ElementDefinition.path [ fhir:value "MedicationRequest.dispenseRequest.numberOfRepeatsAllowed" ] ;
       fhir:ElementDefinition.short [ fhir:value "Número de repetições autorizadas" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Um número inteiro que indica quantas vezes, além da dispensação inicial (também conhecidas como renovações ou repetições), o paciente pode receber a medicação prescrita. Observações de uso: Este número inteiro não inclui a dispensação da prescrição inicial. Isso significa que, se uma prescrição indicar a dispensação de 30 comprimidos mais '3 repetições', a prescrição poderá ser dispensada um total de 4 vezes e o paciente poderá receber um total de 120 comprimidos. O médico pode especificar explicitamente que não são permitidas renovações após a dispensação inicial." ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "MedicationRequest.dispenseRequest.quantity" ] ;
       fhir:ElementDefinition.path [ fhir:value "MedicationRequest.dispenseRequest.quantity" ] ;
       fhir:ElementDefinition.short [ fhir:value "Quantidade de medicamento a ser fornecida por dispensação." ] ;
       fhir:ElementDefinition.definition [ fhir:value "A quantidade a ser dispensada." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "http://www.saude.gov.br/fhir/r4/ValueSet/BRUnidadeMedidaMedicamento" ;
           fhir:link <http://www.saude.gov.br/fhir/r4/ValueSet/BRUnidadeMedidaMedicamento>
         ]
       ]
     ], [
