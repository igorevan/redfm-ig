       fhir:ElementDefinition.path [ fhir:value "MedicationDispense.detectedIssue" ] ;
       fhir:ElementDefinition.short [ fhir:value "Referência à condição clínica" ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "MedicationDispense.eventHistory" ] ;
       fhir:ElementDefinition.path [ fhir:value "MedicationDispense.eventHistory" ] ;
