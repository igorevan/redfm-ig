         fhir:ElementDefinition.constraint.expression [ fhir:value "MedicationRequest.requester.resolve().ofType(PractitionerRole).practitioner.resolve().ofType(Practitioner).identifier.type.coding.exists(code = 'MD' or code = 'RN' or code = 'RI' or code = 'MRT')" ]
