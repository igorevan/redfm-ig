       fhir:ElementDefinition.path [ fhir:value "MedicationRequest.intent" ] ;
       fhir:ElementDefinition.short [ fhir:value "O tipo de requisição de medicamento." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Tipo de requisição de medicamento: prescrição, prescrição original, prescrição automática, reposição, refill, planejada, opcional (a critério médico), instância específica da prescrição" ] ;
       fhir:ElementDefinition.fixedCode [ fhir:value "order" ]
